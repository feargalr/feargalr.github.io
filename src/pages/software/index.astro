---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ToolCard from '../../components/ToolCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import software from '../../data/software.yaml';
---
<Base title="Software & methods" description="Microbiome software and methods by Feargal J. Ryan: TaxSEA (Bioconductor), OpusTaxa, SPINGO and Demovir, plus benchmarks and best-practice guidance for metagenomic and virome analysis.">
  <PageHead title="Software & methods" intro="Open-source tools for microbiome analysis, and the benchmarks and best-practice guidance behind them. Bug reports and feature requests are welcome on GitHub." />
  <div class="wrap page-body">
    <section aria-label="Featured">
      <div class="soft-feature">
        {software.featured.map((t: any, i: number) => <ToolCard tool={t} lead={i === 0} />)}
        <ArticleCard />
      </div>
    </section>

    <section aria-labelledby="more-h">
      <h2 class="sub-h" id="more-h">More tools &amp; best practice</h2>
      <div class="soft-more">
        {software.more.map((m: any) => (
          <div class="mini">
            <h3>{m.name}</h3>
            <span class="note">{m.note}</span>
            <p>{m.description}</p>
            <p class="mini-link">{m.links.map((l: any) => <a href={l.url}>{l.label}</a>)}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>
