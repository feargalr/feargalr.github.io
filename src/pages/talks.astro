---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TalkList from '../components/TalkList.astro';
---
<Base title="Talks" description="Invited talks and seminars by Dr Feargal J. Ryan on the microbiome, systems immunology and computational biology.">
  <PageHead title="Talks" intro="Regularly invited to present at national and international conferences and institutes." />
  <div class="wrap page-body">
    <TalkList />
    <div class="talks-foot">
      <a class="btn btn-ghost" href="/contact/?topic=talks">Invite Feargal to speak</a>
      <p>Seminars, keynotes, workshops and panels on microbiome science and computational biology.</p>
    </div>
  </div>
</Base>
