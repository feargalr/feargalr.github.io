---
import scholar from '../data/scholar.json';
import { fmt } from '../lib/format';

const data = scholar.per_year;
const W = 560, H = 250, L = 46, R = 8, T = 18, B = 30;
const peak = Math.max(...data.map((d) => d.cites));
const step = peak > 1500 ? 500 : peak > 600 ? 250 : 100;
const max = Math.ceil(peak / step) * step;
const ticks = Array.from({ length: max / step + 1 }, (_, i) => i * step);
const cw = (W - L - R) / data.length, bw = cw * 0.62;
const y = (v: number) => T + (H - T - B) * (1 - v / max);
const retrieved = new Date(scholar.retrieved);
const currentYear = retrieved.getFullYear();
const monthName = retrieved.toLocaleString('en-AU', { month: 'long' });
const dateLabel = retrieved.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
const last = data[data.length - 1];
const label = `Citations per year, ${data[0].year} to ${last.year}: ` + data.map((d) => `${d.year} ${d.cites}`).join(', ');
---
<figure class="chart">
  <h3>Citations per year</h3>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
    <defs>
      <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="2.4" height="6" fill="var(--teal)" />
      </pattern>
    </defs>
    {ticks.map((v) => (
      <g>
        <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="var(--line-2)" stroke-width="1" />
        <text x={L - 8} y={y(v) + 4} text-anchor="end" font-size="11" fill="var(--ink-3)" font-family="IBM Plex Mono, monospace">{fmt(v)}</text>
      </g>
    ))}
    {data.map((d, i) => {
      const x = L + i * cw + (cw - bw) / 2;
      const partial = d.year === currentYear;
      const labelled = i >= data.length - 2;
      return (
        <g>
          <rect x={x} y={y(d.cites)} width={bw} height={y(0) - y(d.cites)} rx="2"
            fill={partial ? 'url(#hatch)' : 'var(--teal)'} stroke={partial ? 'var(--teal)' : 'none'} stroke-width="1" />
          <text x={x + bw / 2} y={H - 10} text-anchor="middle" font-size="11" fill="var(--ink-3)" font-family="IBM Plex Mono, monospace">'{String(d.year).slice(2)}</text>
          {labelled && <text x={x + bw / 2} y={y(d.cites) - 6} text-anchor="middle" font-size="11" font-weight="600" fill="var(--ink-2)" font-family="IBM Plex Mono, monospace">{fmt(d.cites)}</text>}
        </g>
      );
    })}
  </svg>
  <figcaption class="src">
    <a href={scholar.source}>Google Scholar</a>, retrieved {dateLabel}.
    {last.year === currentYear && ` The ${currentYear} bar covers January to ${monthName}.`}
  </figcaption>
</figure>
